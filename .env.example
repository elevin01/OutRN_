# Postgres connection for the pipeline (local dev cluster or Supabase pooler URL)
DATABASE_URL=postgres://outrn@127.0.0.1:54329/outrn

# Identify ourselves to public APIs (Overpass and NWS both ask for this)
OUTRN_USER_AGENT="outrn-dev (contact: you@example.com)"

# Overpass instance. Never point production at the free public instance.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Claude reads the venues' pages no structured data describes, and re-checks events about to start
# (outrn refresh runs it when the key is set). Leave blank to turn it off.
ANTHROPIC_API_KEY=
# Most it may spend over any 24 hours, in dollars (default 1.00), and the model (default claude-opus-5-5;
# claude-haiku-5-5 costs far less per page).
OUTRN_AI_DAILY_BUDGET_USD=1.00
OUTRN_AI_MODEL=

# Ticketed events (outrn refresh runs them when set; each source is switched off until its terms are
# reviewed, see migration 0028). Free keys: developer.ticketmaster.com and seatgeek.com/account/develop
TICKETMASTER_API_KEY=
SEATGEEK_CLIENT_ID=
# Which films are popular now (TMDB: a v3 API key or v4 read access token; off until its terms are
# reviewed, see migration 0029). Free: themoviedb.org/settings/api
TMDB_API_KEY=
