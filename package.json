{
  "name": "outrn",
  "private": true,
  "version": "0.1.0",
  "description": "OutRN \u2014 feasibility-first local discovery. Automated supply, deterministic engine, humans correcting the gaps.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --parallel --filter @outrn/api --filter @outrn/web run dev",
    "dev:mock": "pnpm --parallel --filter @outrn/api --filter @outrn/web run dev:mock",
    "api:dev": "pnpm --filter @outrn/api dev",
    "api:start": "pnpm --filter @outrn/api start",
    "api:mock": "pnpm --filter @outrn/api mock",
    "web:dev": "pnpm --filter @outrn/web dev",
    "web:build": "pnpm --filter @outrn/web build",
    "web:start": "pnpm --filter @outrn/web start",
    "contracts:schema": "pnpm --filter @outrn/contracts schema",
    "fixtures": "pnpm --filter @outrn/api fixtures",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "lint": "eslint .",
    "db:start": "bash scripts/db-start.sh",
    "db:migrate": "tsx --conditions=outrn-src packages/db/src/bin.ts migrate",
    "db:reset": "tsx --conditions=outrn-src packages/db/src/bin.ts reset",
    "outrn": "tsx --conditions=outrn-src packages/cli/src/main.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0"
  }
}
