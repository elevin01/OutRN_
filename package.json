{
  "name": "outrn",
  "private": true,
  "version": "0.1.0",
  "description": "OutRN — feasibility-first local discovery. Automated supply, deterministic engine, humans correcting the gaps.",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:start": "bash scripts/db-start.sh",
    "db:migrate": "pnpm --filter @outrn/db run migrate",
    "db:reset": "pnpm --filter @outrn/db run reset",
    "outrn": "pnpm --filter @outrn/cli run outrn --"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "tsx": "^4.19.0"
  }
}
